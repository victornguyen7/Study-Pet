{
  "manifest_version": 3,
  "name": "Study Pet",
  "version": "0.5.0",
  "description": "Tells the Study Pet app which page is in front, for pages you allow. It asks once per site and remembers your answer.",
  "key": "",
  "icons": { "128": "icon.png" },
  "permissions": ["tabs", "storage", "nativeMessaging", "alarms", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup.html", "default_title": "Study Pet" }
}
